# Copier en paths.env (non versionné) : sourcé automatiquement par jobs/_common.sh.
# Toutes les variables sont facultatives ; les valeurs ci-dessous sont les défauts.

# --- wandb ---
export WANDB_PROJECT=madevo
export WANDB_ENTITY=arthurfou-cole-polytechnique
# offline sur un nœud sans internet (puis `wandb sync <dossier>`).
# ⚠️ Ne JAMAIS utiliser `disabled` : le nom du run devient dummy-xxx et la reprise casse.
# jobs/_common.sh le remplace d'office par `offline` si on l'oublie.
# export WANDB_MODE=offline

# --- emplacements ---
# Données et poids (par défaut datasets/ et pretrained/ dans le repo).
# export MADEVO_DATASETS=/data/arthur/madevo/datasets
# export MADEVO_PRETRAINED=/data/arthur/madevo/pretrained

# Sorties : runs d'entraînement, évals, logs Slurm (par défaut dans le repo, ignorés par git).
# Les mettre sur le disque de données d'un serveur quand le home a un quota.
# export MADEVO_RUNS=/data/arthur/madevo/runs
# export MADEVO_EVALS=/data/arthur/madevo/evals_out
# export MADEVO_LOGS=/data/arthur/madevo/logs

# --- env conda ---
# export MADEVO_CONDA_ENV=madevo
